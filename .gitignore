.turbo/
.vercel/
.cache/
.parcel-cache/
dist/
build/
out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.python-version.local
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
