# =============================================================================
# ai-devkit-starter — .gitignore
# Policy: the repository is tool-agnostic. AI agent tooling (instructions,
# memory, hooks, graphs, plans) is LOCAL-ONLY and never committed — every
# developer regenerates it with the README "Per-project setup" step.
# Patterns omit the trailing "/" so they also match symlinks
# (e.g. CLAUDE.md -> AGENTS.md, .claude -> .agents).
# =============================================================================

# -----------------------------------------------------------------------------
# AI agent tooling (local-only)
# -----------------------------------------------------------------------------

# --- Starter-kit stack -------------------------------------------------------
# OpenWolf: project memory, index, hooks
.wolf
# Graphify: knowledge graph output + config
graphify-out
.graphify
.graphifyrc
.graphifyignore
# Superpowers: scratch state only (brainstorm companion, subagent progress).
# Exception: docs/superpowers/ (specs + plans) IS committed as project history.
.superpowers
# RTK: installed globally (`rtk init -g`), writes nothing into the project.

# --- Agent instruction / memory files (any directory) ------------------------
CLAUDE.md
CLAUDE.local.md
AGENTS.md
AGENTS.override.md
GEMINI.md
QWEN.md
WARP.md
CRUSH.md
KIRO.md
CODEBUDDY.md
.cursorrules
.windsurfrules
.clinerules
.roorules
.goosehints
.github/copilot-instructions.md
.github/instructions/
.github/prompts/
.github/chatmodes/

# --- Agent config directories ------------------------------------------------
.claude
.agent
.agents
.gemini
.codex
.cursor
.windsurf
.codeium
.kiro
.continue
.cline
.roo
.aider*
.opencode
.kilocode
.qwen
.crush
.warp
.junie
.trae
.augment
.amazonq
.devin
.factory
.grok
