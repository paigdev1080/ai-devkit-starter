.pi
.hermes
.muse
.mcp.json
.agentignore
.cursorignore
.geminiignore

# -----------------------------------------------------------------------------
# Secrets & environment  (never commit; ship a .env.example instead)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
credentials.json
service-account*.json
secrets.*
!secrets.example.*
.netrc
.npmrc.local

# -----------------------------------------------------------------------------
# Operating systems
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Editors & IDEs  (share only curated settings)
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
*.swp
*.swo
*.sublime-workspace
.history/
.fleet/
.zed/

# -----------------------------------------------------------------------------
# Logs, temp, coverage
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
*.tmp
*.bak
coverage/
.nyc_output/
*.lcov
htmlcov/
.coverage
.coverage.*

# -----------------------------------------------------------------------------
# Language ecosystems (safe defaults — prune what you don't use)
# -----------------------------------------------------------------------------

# Node / JS / TS
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
.npm/
.eslintcache
